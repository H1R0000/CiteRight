  "narrative": {
    "northStar": "The Playful Digital Library",
    "overview": "Violet identity, mint and butter-yellow book objects, pale lavender surfaces, and rounded controls make an approachable academic workspace. Manrope gives navigation and metadata a consistent voice; serif citation output makes the finished reference easy to distinguish.\n\nDiscovery is expressive while editing stays calm and compact. This document captures the completed, user-approved code-led direction in `src/styles.css`; `.impeccable/surface.md` records the concept-launcher limitation. Render references live in `docs/screenshots/`. The independent finishing review resolved both typography findings and returned **ship**.",
    "keyCharacteristics": [
      "Playful geometric books with bounded decorative motion.",
      "Violet actions, mint reassurance, and yellow accents.",
      "Calm editing surfaces with readable citation guidance.",
      "Responsive layouts and equivalent light/dark roles."
    ],
    "rules": [
      {
        "name": "The Readable Guidance Rule",
        "body": "Keep field hints, optional-label guidance, readiness text, and suggested-search text at the final 12px size across breakpoints. These trailing stylesheet overrides deliberately supersede earlier smaller declarations.",
        "section": "typography"
      },
      {
        "name": "The Reduced Motion Rule",
        "body": "Under `prefers-reduced-motion: reduce`, animation and transition durations become .01ms, animation delays become zero, iteration counts become one, and scrolling becomes immediate. The flying book is hidden, and button/cover hover movement is suppressed. Readiness links also choose immediate scrolling. Maintain textual feedback so motion never carries the outcome alone.",
        "section": "components"
      }
    ],
    "dos": [
      "Do reuse semantic colors so light and dark modes preserve the same hierarchy.",
      "Do keep citation guidance and suggested-search text at 12px across breakpoints.",
      "Do preserve visible focus, wrapping labels, and reduced-motion feedback.",
      "Do keep decorative animation bounded and the editor calm."
    ],
    "donts": [
      "Don't invent publication details, statistics, or accuracy claims as visual filler.",
      "Don't turn the finite book float into an endless decorative loop.",
      "Don't replace readable citation output with decorative display lettering.",
      "Don't use external raster artwork for the geometric book illustration; it is implemented in CSS and SVG."
    ]
  }
}

