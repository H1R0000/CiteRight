    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Implemented button variant with keyboard, hover, active, disabled, and reduced-motion states.",
      "html": "<button class=\"ds-button ds-button-primary\" type=\"button\">Save to my library</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:11px 18px;border:1px solid transparent;border-radius:10px;font:750 13px/1.35 'Manrope Variable',sans-serif;cursor:pointer;transition:background .18s,transform .18s,box-shadow .18s}.ds-button:hover:not(:disabled){transform:translateY(-2px)}.ds-button:active:not(:disabled){transform:translateY(0) scale(.98)}.ds-button:focus-visible{outline:3px solid var(--purple,#7043c3);outline-offset:4px}.ds-button:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition-duration:.01ms}.ds-button:hover:not(:disabled){transform:none}}.ds-button-primary{background:var(--purple,#7043c3);color:#fff;box-shadow:0 5px 12px -6px #7043c366}.ds-button-primary:hover:not(:disabled){background:var(--purple-hover,#5f33b1)}"
